# Generated by npm run backend for a local Convex deployment.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# Optional frontend control endpoint; HTTPS applications require trusted WSS.
NEXT_PUBLIC_CONTROL_URL=ws://127.0.0.1:8765/control

# Store the following privately in .env.agent on the operator computer:
# IRIS_AGENT_TOKEN=operator-fleet-credential-issued-in-fleet
# IRIS_ALLOWED_ORIGIN=http://127.0.0.1:3000
# IRIS_CONTROL_PORT=8765
# IRIS_CONTROL_TLS_CERT=/absolute/path/to/certificate.pem
# IRIS_CONTROL_TLS_KEY=/absolute/path/to/private-key.pem

# Configure these in Convex, never NEXT_PUBLIC_ variables:
# JWT_PRIVATE_KEY and JWKS: npm run auth:setup
# AUTH_RESEND_KEY and AUTH_EMAIL_FROM: production password recovery
