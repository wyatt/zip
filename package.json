{
  "name": "iris-simulated-flight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "backend": "convex dev",
    "agent": "bun --env-file=.env.local --env-file=.env.agent agent/index.ts",
    "agent:demo": "bun --env-file=.env.local --env-file=.env.agent agent/index.ts --demo",
    "ithaca:acquire": "bash scripts/acquire-ithaca.sh",
    "auth:setup": "node scripts/setup-auth.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@fontsource/lato": "latest",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "convex": "latest",
    "hls.js": "1.7.2",
    "jpeg-js": "^0.4.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "next": "latest",
    "pixelarticons": "^2.4.1",
    "pngjs": "^7.0.0",
    "react": "latest",
    "react-dom": "latest",
    "three": "0.180.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "latest",
    "@playwright/test": "latest",
    "@types/jpeg-js": "^0.3.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "latest",
    "@types/pngjs": "^6.0.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "convex-test": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
